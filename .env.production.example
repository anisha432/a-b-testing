# ExperimentIQ Production Environment
# Copy this to .env.production and fill in real values
# NEVER commit .env.production to git

# ═══════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════
# For Docker Compose (internal): postgresql://experimentiq:STRONG_PASSWORD@db:5432/experimentiq
# For external DB (Railway/Neon/Supabase): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://experimentiq:CHANGE_ME_STRONG_PASSWORD@db:5432/experimentiq

# ═══════════════════════════════════════════
# JWT AUTHENTICATION
# ═══════════════════════════════════════════
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ═══════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════
# Comma-separated list of allowed origins
# Include your production domain and any staging domains
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ═══════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════
# For Docker Compose (internal nginx proxy): leave empty or /api
# For separate deployment: https://your-api-domain.com
VITE_API_URL=

# ═══════════════════════════════════════════
# APP
# ═══════════════════════════════════════════
APP_NAME=ExperimentIQ
APP_ENV=production
PORT=8000

# ═══════════════════════════════════════════
# POSTGRES (for Docker Compose db service)
# ═══════════════════════════════════════════
POSTGRES_USER=experimentiq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=experimentiq
